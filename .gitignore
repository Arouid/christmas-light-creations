# Owner photo drop: originals may contain GPS location data, never commit
photos-incoming/
gift-wrap-incoming/
# Old WordPress backup from GoDaddy: contains customer data, never commit
old-site-backup/

# Security review: lists open weak spots; the repo is public, so keep it local
docs/security-review.md

# Upscaled (3x) copies of the 2012 backdrop art: 13 MB, rebuildable from the originals next to them
assets-source/2012-backdrop/hi-res-3x/

# Google Ads video: rebuildable with scripts/ads-video.py; MP4s are big, keep only the README
assets-source/ads/video/*
!assets-source/ads/video/README.md

# Remotion video workspace (video/): copies of photos, logo and fonts made by video/scripts/prepare-assets.mjs,
# and Remotion's own output. Photos may carry GPS data, never commit.
video/public/
video/out/
# ...except the 5-second ad (owner 2026-10-11: "commit the 5 second ad, I don't want to lose it"; ~5 MB in all)
!assets-source/ads/video/clc-teaser-5s-*.mp4

# Shirt designs (assets-source/shirts/designs/): the 300-dpi print PNGs are 1–5 MB each and rebuild in two
# minutes with `node scripts/shirt-designs.mjs`; the SVG, PDF, mockups, sheet and README stay in git.
assets-source/shirts/designs/*.png
!assets-source/shirts/designs/mockup-*.png
!assets-source/shirts/designs/preview-sheet.png

# Stock downloads (Vecteezy): licensed to us, never redistributed; the repo is public.
assets-source/Vecteezy Downloads/
# Envato Elements downloads: licensed per project to us, never redistributed (assets-source/envato/README.md).
assets-source/envato/downloads/
# Licensed downloads for the ads (Uppbeat music, sound effects, footage): per-licence, not redistributable
assets-source/ads/clips/
assets-source/ads/sfx/
assets-source/ads/music/

# Uppbeat motion-graphics downloads (overlays, transitions; GBs, licensed): never commit
assets-source/ads/Mothion Graphics/
assets-source/ads/motion/
