# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
# Written by the deploy workflow's Changed pages step (scripts/indexnow.mjs --compare), read by its IndexNow ping
changed-pages.json
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Owner photo drop: originals may contain GPS location data, never commit
photos-incoming/
gift-wrap-incoming/
# Old WordPress backup from GoDaddy: contains customer data, never commit
old-site-backup/

# Security review: lists open weak spots; the repo is public, so keep it local
docs/security-review.md

# Upscaled (3x) copies of the 2012 backdrop art: 13 MB, rebuildable from the originals next to them
assets-source/brand/2012-backdrop/hi-res-3x/

# Google Ads video: rebuildable with scripts/ads-video.py; MP4s are big, keep only the README
assets-source/ads/video/*
!assets-source/ads/video/README.md

# Remotion video workspace (video/): copies of photos, logo and fonts made by video/scripts/prepare-assets.mjs,
# and Remotion's own output. Photos may carry GPS data, never commit.
video/public/
video/out/
# ...except the 5-second ad (owner 2026-10-11: "commit the 5 second ad, I don't want to lose it"; ~5 MB in all)
!assets-source/ads/video/clc-teaser-5s-*.mp4

# Shirt designs (assets-source/shirts/designs/): the 300-dpi print PNGs are 1–5 MB each and rebuild in two
# minutes with `node scripts/shirt-designs.mjs`; the SVG, PDF, mockups, sheet and README stay in git.
assets-source/shirts/designs/*.png
!assets-source/shirts/designs/mockup-*.png
!assets-source/shirts/designs/preview-sheet.png
# AI-made shirt art downloaded from Recraft (up to 15 MB each) and the knock-out prints made from it
# (scripts/shirt-knockout.mjs): kept on this computer only.
assets-source/shirts/recraft/

# Stock downloads (Vecteezy): licensed to us, never redistributed; the repo is public.
assets-source/stock/vecteezy/
# Envato Elements downloads: licensed per project to us, never redistributed (assets-source/stock/envato/README.md).
assets-source/stock/envato/downloads/
# Licensed downloads for the ads (Uppbeat music, sound effects, footage): per-licence, not redistributable
assets-source/ads/clips/
assets-source/ads/sfx/
assets-source/ads/music/

# Uppbeat motion-graphics downloads (overlays, transitions; GBs, licensed), extracted: never commit
assets-source/ads/motion/
# Install photos the owner downloads from Google Photos (originals, 2026-10-14): customers' houses, never committed.
assets-source/photos/google-photos/
# Hi-res gallery originals (owner, 2026-10-14, 3 MB each): the web copies in public/images/gallery/ are made from these.
assets-source/photos/gallery-hi-res/
# The owner's gift-wrapping photos (2026-10-15, up to 2752 px): the web copies in public/images/gift-wrap/ are made from these.
assets-source/ads/Gift-Wrapping/
# dev-workflow-core (plugin) local state: per-machine, never committed. The config and baseline are.
.claude/dev-workflow.teststate.json
.claude/.coordination-cache.json
.claude/.coordination-vus.json
