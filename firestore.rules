rules_version = '2';

// Customers can only ADD an estimate request. Only staff (an email listed in
// the `staff` collection, signed in with Google) can read leads or change
// their status and notes. Nobody can delete through the app.
service cloud.firestore {
  match /databases/{database}/documents {

    // Staff = Google sign-in only: a customer account's email link never
    // counts, even for an address on the staff list (security review 2026-10-09).
    function isStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/staff/$(request.auth.token.email.lower()));
    }

    function shortStr(v, max) {
      return v is string && v.size() <= max;
    }

    function filledStr(v, max) {
      return shortStr(v, max) && v.size() > 0;
    }

    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly([
            'firstName', 'lastName', 'email', 'phone', 'address', 'city', 'zip',
            'contactMethod', 'message', 'source', 'status', 'notes', 'createdAt'])
        && filledStr(request.resource.data.firstName, 80)
        && filledStr(request.resource.data.lastName, 80)
        && filledStr(request.resource.data.email, 200)
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && shortStr(request.resource.data.phone, 40)
        && filledStr(request.resource.data.address, 200)
        && shortStr(request.resource.data.city, 80)
        && shortStr(request.resource.data.zip, 10)
        && request.resource.data.contactMethod in ['Phone', 'Text', 'Email']
        && filledStr(request.resource.data.message, 3000)
        && (!('source' in request.resource.data) || shortStr(request.resource.data.source, 60))
        && request.resource.data.status == 'new'
        && request.resource.data.notes == ''
        && request.resource.data.createdAt == request.time;

      allow read: if isStaff();

      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'notes', 'updatedAt', 'updatedBy', 'customerId', 'geo', 'geoMissing'])
        && request.resource.data.status in ['new', 'called', 'estimate-sent', 'booked', 'lost', 'spam']
        && shortStr(request.resource.data.notes, 5000)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;

      // Only leads first marked Spam / test can be deleted (two steps, so a
      // real request can't vanish with one tap). Owner approved 2026-10-09.
      allow delete: if isStaff() && resource.data.status == 'spam';
    }

    // Customer records (the old Google Sheet). Staff only; every change is
    // stamped with who made it; nobody deletes through the app.
    match /customers/{customerId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && filledStr(request.resource.data.fullName, 200)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if false;
    }

    // Service calls and neighborhood gate codes: staff only, stamped writes.
    match /serviceCalls/{callId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && filledStr(request.resource.data.customerId, 200)
        && request.resource.data.status in ['Open', 'Scheduled', 'Done', 'Cancelled']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if false;
    }

    match /gateCodes/{gateId} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff()
        && filledStr(request.resource.data.neighborhood, 120)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
    }

    // Custom tabs (saved filters) shared by all staff.
    match /views/{viewId} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff()
        && filledStr(request.resource.data.name, 60)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
    }

    // Past texts/calls/voicemails imported from the old Google Voice account.
    // History: staff can read and (re-)import; nobody deletes.
    match /messages/{messageId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && filledStr(request.resource.data.customerId, 200)
        && request.resource.data.direction in ['in', 'out']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if false;
    }

    // Past estimate requests from the old website (imported once), worked as
    // a call/email list. Staff read, import and update; nobody deletes.
    match /pastRequests/{requestId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if false;
    }

    // Road-sign placements ("drops") for the sign ROI tab. Staff can delete
    // a mistaken entry; nothing else depends on them.
    match /signs/{signId} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff()
        && filledStr(request.resource.data.corner, 120)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
    }

    // Service routes: a day's stops (snapshots of customer name, address,
    // phone, gate code, notes) with their status. Staff only.
    match /routes/{routeId} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.day is string
        && request.resource.data.stops is list
        && request.resource.data.stops.size() <= 60
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
    }

    // Light designs (designer JSON + small preview) for a customer or lead,
    // and their large images (photo, finished render) as separate docs.
    match /designs/{designId} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff()
        && filledStr(request.resource.data.ownerId, 200)
        && request.resource.data.designJson is string
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
    }
    match /designFiles/{fileId} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 1040000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
    }

    // Proposals (estimate + contract). The document id is the customer's
    // unguessable link token. The public can open one only by that exact id
    // (no listing), mark it viewed, and sign it once: the signature must
    // carry the fingerprint of what was sent. Staff manage everything else.
    function stamped() {
      return request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
    }
    function publicView() {
      return resource.data.status == 'sent'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'viewedAt'])
        && request.resource.data.status == 'viewed'
        && request.resource.data.viewedAt == request.time;
    }
    function publicSign() {
      let sig = request.resource.data.signature;
      return resource.data.status in ['sent', 'viewed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'signature', 'signedAt'])
        && request.resource.data.status == 'signed'
        && request.resource.data.signedAt == request.time
        && sig.keys().hasOnly(['name', 'image', 'consent', 'docHash', 'userAgent'])
        && filledStr(sig.name, 120)
        && sig.consent == true
        && sig.docHash == resource.data.docHash
        && sig.image is string && sig.image.size() < 300000
        && sig.image.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$')
        && shortStr(sig.userAgent, 200);
    }
    match /proposals/{token} {
      allow get: if true;
      allow list: if isStaff();
      allow create: if isStaff() && stamped();
      // Payments (deposit, payments.*) are recorded only by the server
      // (captureDepositOrder), never typed in from the app.
      allow update: if (isStaff() && stamped()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deposit', 'payments']))
        || publicView() || publicSign();
      // Drafts, never-signed voided ones and test-mode payments can be deleted;
      // signed or really-paid proposals stay as the record (owner, 2026-10-09).
      allow delete: if isStaff() && (resource.data.status == 'draft'
        || (resource.data.status == 'void' && !('signature' in resource.data))
        || ('deposit' in resource.data && resource.data.deposit.env == 'sandbox' && !('payments' in resource.data)));
    }
    // Images shown on a proposal page (design + before photo), by token.
    match /proposalFiles/{fileId} {
      allow get: if true;
      allow create, update: if isStaff() && stamped()
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 1040000;
      allow delete: if isStaff();
    }

    // When customers signed in to their own account (/account/): one doc per
    // lowercase email, written only by the server (myAccount). Staff read only.
    match /customerLogins/{email} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Shared staff settings (home base for distances and routes).
    match /settings/{settingId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if false;
    }

    // Staff list: one document per person, ID = their lowercase Google email.
    // Managed in the Firebase console only.
    match /staff/{email} {
      allow read: if isStaff();
      allow write: if false;
    }
  }
}
